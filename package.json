{
  "name": "pupluv",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "oxlint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:claim": "dotenv -e .env.local -- tsx scripts/claim-dogs.ts",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "cap:sync": "pnpm build && cap sync",
    "cap:ios": "cap open ios",
    "desktop:dev": "tauri dev",
    "desktop:build": "bash scripts/build-desktop.sh",
    "desktop:install": "bash scripts/install-desktop.sh",
    "verify": "pnpm check && pnpm lint && pnpm test && pnpm build",
    "ios:device": "bash scripts/install-ios.sh",
    "icons": "node scripts/make-icons.mjs",
    "glyphs": "tsx scripts/make-glyphs.mts",
    "db:backup": "dotenv -e .env.local -- tsx scripts/backup-db.ts",
    "db:restore": "dotenv -e .env.local -- tsx scripts/restore-db.ts"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/vercel": "^11.0.11",
    "@base-ui/react": "^1.8.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@nanostores/react": "^2.0.1",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.3.5",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.3",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.46.0",
    "nanostores": "^1.5.4",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@twemoji/svg": "^15.0.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "oxlint": "^1.83.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
