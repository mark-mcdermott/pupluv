# Copy to .env.local and fill in. Every value here also lives in the Vercel
# project, which is the source of truth — `vercel env pull .env.local` writes
# this file for you rather than hunting them down one at a time.

# --- required ---------------------------------------------------------------

# Neon, pooled connection string. Drizzle, the API routes and every db: script
# read this; without it `getDb()` throws on first use.
DATABASE_URL=

# What Better Auth signs sessions with. Any long random string —
# `openssl rand -base64 32`. Rotating it signs everybody out once.
AUTH_SECRET=

# --- native builds only -----------------------------------------------------

# The origin the bundled apps call. They serve their own UI from
# capacitor://localhost and tauri://localhost, so "same origin" means nothing
# there and the deployed origin is baked in at build time. Leave it unset for
# the web build, which is same-origin by definition.
#
# No trailing slash: it would make every path //api/..., which Vercel answers
# with a 308, and a cross-origin POST does not survive a redirect.
PUBLIC_API_URL=

# --- optional ---------------------------------------------------------------

# Pins the origin Better Auth believes it is serving from. Unset, it reads that
# off each request, which is right everywhere this runs today.
# BETTER_AUTH_URL=

# Set by Vercel on every deployment, and used to trust preview URLs so a branch
# deploy can sign in without configuration. Nothing to put here locally.
# VERCEL_URL=
# VERCEL_BRANCH_URL=
